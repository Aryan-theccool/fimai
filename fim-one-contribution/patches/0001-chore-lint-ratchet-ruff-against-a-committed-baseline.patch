 web = [
@@ -120,6 +125,14 @@ src = ["src"]
 [tool.ruff.lint]
 select = ["E", "F", "I", "N", "UP", "B", "SIM", "RUF"]
 
+[tool.ruff.lint.per-file-ignores]
+# Alembic autogenerate output. The template emits `from typing import
+# Sequence, Union` and long `Revises:` docstring lines, and a migration is a
+# historical record — rewriting one that already ran against a production
+# database to satisfy pyupgrade is worse than leaving it unlinted. This one
+# exemption removes 382 violations (mostly UP007/UP035) from the baseline.
+"src/fim_one/migrations/versions/*" = ["E501", "F401", "I001", "UP007", "UP017", "UP035"]
+
 [tool.mypy]
 python_version = "3.11"
 strict = true
