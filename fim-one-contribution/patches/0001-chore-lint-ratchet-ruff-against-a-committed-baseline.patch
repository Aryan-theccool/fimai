-    "ruff>=0.8",
+    # Upper-bounded on purpose: `ruff check src/ tests/` is gated against a
+    # committed baseline (scripts/ruff_gate.py), and a floating `ruff>=0.8`
+    # lets every `uv lock` silently move that number — 0.8.0 reports 2095
+    # violations on this tree, 0.15.2 reports 2106. Bump the bound in the
+    # same commit that re-records the baseline.
+    "ruff>=0.15,<0.16",
     "mypy>=1.13",
